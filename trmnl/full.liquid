{%- assign chs = "senate,house,gov" | split: "," -%}
{%- assign devs = "og,x" | split: "," -%}
<div class="layout layout--col layout--top layout--stretch-x gap--small">

{%- if view == "overview" -%}
  {%- comment -%} ========== OVERVIEW: three chambers + key races + latest calls ========== {%- endcomment -%}
  <div class="grid grid--cols-3 gap--large w--full">
  {%- for ch in chs -%}
    {%- case ch -%}
      {%- when "senate" -%}{%- assign c = senate -%}{%- assign tot = 100 -%}{%- assign cname = t_senate -%}{%- assign need = "51" -%}
      {%- when "house" -%}{%- assign c = house -%}{%- assign tot = 435 -%}{%- assign cname = t_house -%}{%- assign need = "218" -%}
      {%- else -%}{%- assign c = gov -%}{%- assign tot = 50 -%}{%- assign cname = t_gov -%}{%- assign need = "" -%}
    {%- endcase -%}
    {%- comment -%} bar = integer cqw + px remainder (1cqw = 7.8px on OG); a third of the layout = 31.6cqw {%- endcomment -%}
    {%- assign w = c.d | times: 31.6 | divided_by: tot -%}{%- assign dn = w | floor -%}{%- assign dp = w | minus: dn | times: 7.8 | round -%}
    {%- assign w = c.i | times: 31.6 | divided_by: tot -%}{%- assign iN = w | floor -%}{%- assign ip = w | minus: iN | times: 7.8 | round -%}
    {%- assign w = c.r | times: 31.6 | divided_by: tot -%}{%- assign rn = w | floor -%}{%- assign rp = w | minus: rn | times: 7.8 | round -%}
    <div class="flex flex--col flex--left flex--top gap--xsmall w--full">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="title title--small lg:title--medium">{{ cname }}</span>
        {%- if c.ctrl == "D" or c.ctrl == "R" -%}
        <span class="label label--small label--inverted">{% if c.ctrl == "D" %}{{ t_ctrl_d }}{% else %}{{ t_ctrl_r }}{% endif %}</span>
        {%- else -%}
        <span class="label label--small label--gray">{{ c.called }}/{{ c.total }} {{ t_called }}</span>
        {%- endif -%}
      </div>
      <div class="flex flex--row flex--between flex--bottom w--full">
        <div class="flex flex--col flex--left">
          <span class="value value--medium lg:value--large value--tnums">{{ c.d }}</span>
          <span class="label label--small">{{ t_dem }}{% if c.i > 0 %} +{{ c.i }} {{ t_ind }}{% endif %}</span>
        </div>
        <div class="flex flex--col flex--right">
          <span class="value value--medium lg:value--large value--tnums">{{ c.r }}</span>
          <span class="label label--small">{{ t_rep }}</span>
        </div>
      </div>
      <div class="flex flex--row gap--none w--full h--[14px] outline">
        {%- if dn > 0 -%}<div class="bg--black h--full no-shrink w--[{{ dn }}cqw]"></div>{%- endif -%}{%- if dp > 0 -%}<div class="bg--black h--full no-shrink w--[{{ dp }}px]"></div>{%- endif -%}
        {%- if iN > 0 -%}<div class="bg--gray-30 h--full no-shrink w--[{{ iN }}cqw]"></div>{%- endif -%}{%- if ip > 0 -%}<div class="bg--gray-30 h--full no-shrink w--[{{ ip }}px]"></div>{%- endif -%}
        <div class="grow h--full"></div>
        {%- if rp > 0 -%}<div class="bg--gray-50 h--full no-shrink w--[{{ rp }}px]"></div>{%- endif -%}{%- if rn > 0 -%}<div class="bg--gray-50 h--full no-shrink w--[{{ rn }}cqw]"></div>{%- endif -%}
      </div>
      <span class="label label--small">{% if need != "" %}{{ need }} {{ t_to_win }}{% else %}{{ c.won_d }}–{{ c.won_r }} / {{ c.total }} {{ t_races }}{% endif %}</span>
      <span class="label label--small label--gray">{{ t_flips }} D+{{ c.flip_d }} R+{{ c.flip_r }}{% if c.lead_d > 0 or c.lead_r > 0 %} · {{ t_lead }} {{ c.lead_d }}–{{ c.lead_r }}{% endif %}</span>
    </div>
  {%- endfor -%}
  </div>
  <div class="divider"></div>
  {%- assign l1 = battle | where: "s", "lead" -%}{%- assign l2 = battle | where: "s", "wait" -%}{%- assign l3 = battle | where: "s", "called" -%}
  {%- assign blist = l1 | concat: l2 | concat: l3 -%}
  {%- for dev in devs -%}
  {%- if dev == "og" -%}{%- assign nk = 10 -%}{%- assign nc = 10 -%}{%- assign vis = "lg:hidden" -%}{%- else -%}{%- assign nk = 22 -%}{%- assign nc = 22 -%}{%- assign vis = "hidden lg:grid" -%}{%- endif -%}
  <div class="grid w--full gap--large {{ vis }}">
    <div class="col--span-7 flex flex--col flex--left flex--top gap--xsmall">
      <span class="title title--small lg:title--medium">{{ t_key }}</span>
      {%- for r in blist limit: nk -%}
      <div class="grid grid--cols-12 gap--small w--full">
        <span class="col--span-2 label label--small text--bold">{{ r.lbl }}{% if r.o == "G" %} Gov{% elsif r.o == "S" %} Sen{% endif %}</span>
        <span class="col--span-3 label label--small" data-clamp="1">{{ r.a.n }}{% if r.s != "wait" %} {{ r.a.pct }}{% endif %}</span>
        <span class="col--span-3 label label--small" data-clamp="1">{{ r.b.n }}{% if r.s != "wait" %} {{ r.b.pct }}{% endif %}</span>
        <span class="col--span-1 label label--small label--gray">{% if r.s != "wait" %}{{ r.in }}%{% endif %}</span>
        <div class="col--span-3 flex flex--row flex--right">{%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.w }} {{ t_win }}{% if r.f == 1 %} · {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.w }} +{{ r.mg }}</span>{%- else -%}<span class="label label--small label--gray">{% if lang == "fr" %}{{ r.rtfr }}{% else %}{{ r.rt }}{% endif %}</span>{%- endif -%}</div>
      </div>
      {%- endfor -%}
    </div>
    <div class="col--span-5 flex flex--col flex--left flex--top gap--xsmall">
      <span class="title title--small lg:title--medium">{{ t_latest }}</span>
      {%- if calls.size > 0 -%}
        {%- for r in calls limit: nc -%}
        <div class="flex flex--row flex--between flex--center-y gap--small w--full">
          <span class="label label--small" data-clamp="1">{{ r.lbl }}{% if r.o == "S" %} Sen{% elsif r.o == "G" %} Gov{% endif %} · {{ r.wn }}</span>
          <span class="label label--small {% if r.f == 1 %}label--inverted{% else %}label--outline{% endif %}">{{ r.w }}{% if r.f == 1 %} {{ t_flip }}{% endif %}</span>
        </div>
        {%- endfor -%}
      {%- elsif phase == "pre" -%}
        <span class="label label--small label--gray">{{ t_first }}</span>
        <span class="value value--large lg:value--xlarge value--tnums">{{ cd_h }}h{% if cd_m < 10 %}0{% endif %}{{ cd_m }}</span>
        <span class="label label--small">{{ t_next }} · {{ next_time }}</span>
        <span class="label label--small label--gray" data-clamp="2">{{ polls.next_st }}</span>
      {%- else -%}
        <span class="label label--small label--gray">{{ t_none }}</span>
        {%- if polls.next_ts > 0 -%}<span class="label label--small">{{ t_next }} · {{ next_time }} · {{ polls.next_st }}</span>{%- endif -%}
      {%- endif -%}
    </div>
  </div>
  {%- endfor -%}

{%- elsif view == "senate" or view == "house" or view == "governors" -%}
  {%- comment -%} ========== CHAMBER: seat waffle + race list ========== {%- endcomment -%}
  {%- case view -%}
    {%- when "senate" -%}{%- assign c = senate -%}{%- assign tot = 100 -%}{%- assign cname = t_senate -%}{%- assign list = senate_races -%}{%- assign sq = "w--[13px] h--[13px]" -%}{%- assign sqp = "outline" -%}
    {%- when "house" -%}{%- assign c = house -%}{%- assign tot = 435 -%}{%- assign cname = t_house -%}{%- assign list = house_key -%}{%- assign sq = "w--[9px] h--[9px]" -%}{%- assign sqp = "bg--gray-75" -%}
    {%- else -%}{%- assign c = gov -%}{%- assign tot = 50 -%}{%- assign cname = t_gov -%}{%- assign list = gov_races -%}{%- assign sq = "w--[24px] h--[24px]" -%}{%- assign sqp = "outline" -%}
  {%- endcase -%}
  {%- assign rem = tot | minus: c.r -%}
  {%- assign dli = c.d | plus: c.i -%}
  {%- assign l1 = list | where: "s", "lead" -%}{%- assign l2 = list | where: "s", "wait" -%}{%- assign l3 = list | where: "s", "called" -%}
  {%- assign rlist = l1 | concat: l2 | concat: l3 -%}
  <div class="grid w--full gap--large">
    <div class="col--span-5 flex flex--col flex--left flex--top gap--small">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="title lg:title--large">{{ cname }}</span>
        {%- if c.ctrl == "D" or c.ctrl == "R" -%}<span class="label label--inverted">{% if c.ctrl == "D" %}{{ t_ctrl_d }}{% else %}{{ t_ctrl_r }}{% endif %}</span>{%- else -%}<span class="label label--small label--gray">{{ c.called }}/{{ c.total }} {{ t_called }}</span>{%- endif -%}
      </div>
      <div class="flex flex--row flex--between flex--bottom w--full">
        <div class="flex flex--col flex--left"><span class="value value--large lg:value--xlarge value--tnums">{{ c.d }}</span><span class="label">{{ t_dem }}{% if c.i > 0 %} +{{ c.i }} {{ t_ind }}{% endif %}</span></div>
        <div class="flex flex--col flex--center-x"><span class="value value--xsmall value--tnums">{{ c.pending }}</span><span class="label label--small label--gray">{{ t_waiting }}</span></div>
        <div class="flex flex--col flex--right"><span class="value value--large lg:value--xlarge value--tnums">{{ c.r }}</span><span class="label">{{ t_rep }}</span></div>
      </div>
      {%- comment -%} seat waffle — D fills from the start, R from the end, open squares = undecided {%- endcomment -%}
      <div class="flex flex--row flex--wrap gap--[2px] w--full">
        {%- for i in (1..tot) -%}
          {%- if i <= c.d -%}<div class="bg--black {{ sq }}"></div>
          {%- elsif i <= dli -%}<div class="bg--gray-30 {{ sq }}"></div>
          {%- elsif i > rem -%}<div class="bg--gray-50 {{ sq }}"></div>
          {%- else -%}<div class="{{ sqp }} {{ sq }}"></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="flex flex--col flex--left flex--top gap--xsmall">
        {%- if view == "senate" -%}
          <span class="label label--small">51 {{ t_to_win }} · {{ t_vp }}</span>
          <span class="label label--small label--gray">{{ c.hold_d }} D · {{ c.hold_r }} R {{ t_held }}</span>
        {%- elsif view == "house" -%}
          <span class="label label--small">218 {{ t_to_win }}</span>
          {%- if c.pv_in > 0 -%}<span class="label label--small">{{ t_pop }} · D {{ c.pv_d }}% · R {{ c.pv_r }}%</span>{%- endif -%}
        {%- else -%}
          <span class="label label--small">{{ c.won_d }}–{{ c.won_r }} / {{ c.total }} {{ t_races }} · 14 {{ t_held }}</span>
        {%- endif -%}
        <span class="label label--small">{{ t_flips }} D+{{ c.flip_d }} R+{{ c.flip_r }}{% if c.lead_d > 0 or c.lead_r > 0 %} · {{ t_lead }} {{ c.lead_d }}–{{ c.lead_r }}{% endif %}</span>
      </div>
    </div>
    {%- for dev in devs -%}
    {%- if dev == "og" -%}{%- assign nk = 18 -%}{%- assign vis = "lg:hidden" -%}{%- else -%}{%- assign nk = 27 -%}{%- assign vis = "hidden lg:flex" -%}{%- endif -%}
    <div class="col--span-7 flex flex--col flex--left flex--top gap--xsmall {{ vis }}">
      <div class="grid grid--cols-12 gap--small w--full">
        <span class="col--span-2 title title--small">{{ t_race }}</span>
        <span class="col--span-3 title title--small">{{ t_dem }}</span>
        <span class="col--span-3 title title--small">{{ t_rep }}</span>
        <span class="col--span-1 title title--small">%</span>
        <div class="col--span-3 flex flex--row flex--right"><span class="title title--small">{{ t_status }}</span></div>
      </div>
      {%- for r in rlist limit: nk -%}
      <div class="grid grid--cols-12 gap--small w--full">
        <span class="col--span-2 label label--small text--bold">{{ r.lbl }}{% if r.sp == 1 %}*{% endif %}</span>
        <span class="col--span-3 label label--small" data-clamp="1">{{ r.a.n }}{% if r.s != "wait" %} {{ r.a.pct }}{% endif %}</span>
        <span class="col--span-3 label label--small" data-clamp="1">{{ r.b.n }}{% if r.s != "wait" %} {{ r.b.pct }}{% endif %}</span>
        <span class="col--span-1 label label--small label--gray">{% if r.s != "wait" %}{{ r.in }}{% endif %}</span>
        <div class="col--span-3 flex flex--row flex--right">{%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.w }} {{ t_win }}{% if r.f == 1 %} · {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.w }} +{{ r.mg }}</span>{%- else -%}<span class="label label--small label--gray">{% if lang == "fr" %}{{ r.rtfr }}{% else %}{{ r.rt }}{% endif %}</span>{%- endif -%}</div>
      </div>
      {%- endfor -%}
      {%- if rlist.size > nk -%}<span class="label label--small label--gray">+ {{ rlist.size | minus: nk }} {{ t_races }}</span>{%- endif -%}
    </div>
    {%- endfor -%}
  </div>

{%- elsif view == "battleground" or view == "calls" -%}
  {%- comment -%} ========== BATTLEGROUND / LATEST CALLS: two-column cards ========== {%- endcomment -%}
  {%- if view == "battleground" -%}
    {%- assign l1 = battle | where: "s", "lead" -%}{%- assign l2 = battle | where: "s", "wait" -%}{%- assign l3 = battle | where: "s", "called" -%}
    {%- assign list = l1 | concat: l2 | concat: l3 -%}
  {%- else -%}{%- assign list = calls -%}{%- endif -%}
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title lg:title--large">{% if view == "battleground" %}{{ t_battle }}{% else %}{{ t_latest }}{% endif %}</span>
    <span class="label label--small label--gray">{{ t_senate }} {{ senate.called }}/35 · {{ t_house }} {{ house.called }}/435 · Gov {{ gov.called }}/36</span>
  </div>
  {%- if list.size > 0 -%}
  {%- for dev in devs -%}
  {%- if dev == "og" -%}{%- assign nk = 7 -%}{%- assign vis = "lg:hidden" -%}{%- else -%}{%- assign nk = 12 -%}{%- assign vis = "hidden lg:grid" -%}{%- endif -%}
  <div class="grid grid--cols-2 gap--large w--full {{ vis }}">
    {%- for colno in (0..1) -%}
    {%- assign skip = colno | times: nk -%}
    <div class="flex flex--col flex--left flex--top gap--small">
    {%- for r in list offset: skip limit: nk -%}
      <div class="flex flex--col flex--left w--full">
        <div class="flex flex--row flex--between flex--center-y gap--small w--full">
          {%- if view == "calls" -%}
          <span class="title title--small" data-clamp="1">{{ r.wn }} ({{ r.w }})</span>
          {%- if r.f == 1 -%}<span class="label label--small label--inverted">{{ t_flip }}</span>{%- else -%}<span class="label label--small label--gray">{{ r.ts | plus: off | date: tf }}</span>{%- endif -%}
          {%- else -%}
          <span class="title title--small" data-clamp="1">{{ r.lbl }}{% if r.o == "S" %} {{ t_senate }}{% elsif r.o == "G" %} Gov{% endif %}</span>
          {%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.w }} {{ t_win }}{% if r.f == 1 %} · {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.w }} +{{ r.mg }} · {{ r.in }}%</span>{%- else -%}<span class="label label--small label--gray">{% if lang == "fr" %}{{ r.rtfr }}{% else %}{{ r.rt }}{% endif %}</span>{%- endif -%}
          {%- endif -%}
        </div>
        {%- if view == "calls" -%}
        <span class="label label--small label--gray" data-clamp="1">{{ r.lbl }}{% if r.o == "S" %} {{ t_senate }}{% elsif r.o == "G" %} Gov{% else %} {{ t_house }}{% endif %} · {{ r.a.n }} {{ r.a.pct }} – {{ r.b.n }} {{ r.b.pct }}</span>
        {%- else -%}
        <span class="label label--small" data-clamp="1">{{ r.a.n }} ({{ r.a.p }}){% if r.s != "wait" %} {{ r.a.pct }}{% endif %} · {{ r.b.n }} ({{ r.b.p }}){% if r.s != "wait" %} {{ r.b.pct }}{% endif %}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
    </div>
    {%- endfor -%}
  </div>
  {%- endfor -%}
  {%- else -%}
  <div class="flex flex--col flex--center grow w--full gap">
    {%- if phase == "pre" -%}
    <span class="label label--gray">{{ t_first }}</span>
    <span class="value value--xxlarge value--tnums">{{ cd_h }}h{% if cd_m < 10 %}0{% endif %}{{ cd_m }}</span>
    {%- else -%}<span class="title">{{ t_none }}</span>{%- endif -%}
    {%- if polls.next_ts > 0 -%}<span class="label">{{ t_next }} · {{ next_time }} · {{ polls.next_st }}</span>{%- endif -%}
  </div>
  {%- endif -%}

{%- elsif view == "state" -%}
  {%- comment -%} ========== MY STATE: statewide races + House delegation ========== {%- endcomment -%}
  {%- assign hs = focus.house -%}
  {%- assign statewide = focus.senate | concat: focus.gov -%}
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title lg:title--large">{{ focus.nm }}</span>
    <span class="label label--small label--gray">{{ t_close }} {{ focus.closes_ts | plus: off | date: tf }}</span>
  </div>
  <div class="grid w--full gap--large">
    <div class="col--span-6 flex flex--col flex--left flex--top gap--medium">
      {%- for r in statewide -%}
      {%- assign w = r.a.pct | times: 0.48 -%}{%- assign an = w | floor -%}{%- assign ap = w | minus: an | times: 7.8 | round -%}
      {%- assign w = r.b.pct | times: 0.48 -%}{%- assign bn = w | floor -%}{%- assign bp = w | minus: bn | times: 7.8 | round -%}
      <div class="flex flex--col flex--left flex--top gap--xsmall w--full">
        <div class="flex flex--row flex--between flex--center-y w--full">
          <span class="title title--small">{% if r.o == "S" %}{{ t_senate }}{% if r.sp == 1 %} ({{ t_special }}){% endif %}{% else %}{{ t_gov1 }}{% endif %}</span>
          {%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.wn }} {{ t_win }}{% if r.f == 1 %} · {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.in }}% {{ t_in }}</span>{%- else -%}<span class="label label--small label--gray">{% if lang == "fr" %}{{ r.rtfr }}{% else %}{{ r.rt }}{% endif %}</span>{%- endif -%}
        </div>
        <div class="flex flex--row flex--between w--full">
          <span class="label">{{ r.a.n }} ({{ r.a.p }})</span><span class="value value--xsmall value--tnums">{% if r.s != "wait" %}{{ r.a.pct }}%{% else %}–{% endif %}</span>
        </div>
        <div class="flex flex--row flex--between w--full">
          <span class="label">{{ r.b.n }} ({{ r.b.p }})</span><span class="value value--xsmall value--tnums">{% if r.s != "wait" %}{{ r.b.pct }}%{% else %}–{% endif %}</span>
        </div>
        <div class="flex flex--row gap--none w--full h--[10px] outline">
          {%- assign ca = "bg--black" -%}{%- if r.a.p == "R" -%}{%- assign ca = "bg--gray-50" -%}{%- endif -%}
          {%- assign cb = "bg--gray-50" -%}{%- if r.b.p == "D" -%}{%- assign cb = "bg--black" -%}{%- endif -%}
          {%- if an > 0 -%}<div class="{{ ca }} h--full no-shrink w--[{{ an }}cqw]"></div>{%- endif -%}{%- if ap > 0 -%}<div class="{{ ca }} h--full no-shrink w--[{{ ap }}px]"></div>{%- endif -%}
          <div class="grow h--full"></div>
          {%- if bp > 0 -%}<div class="{{ cb }} h--full no-shrink w--[{{ bp }}px]"></div>{%- endif -%}{%- if bn > 0 -%}<div class="{{ cb }} h--full no-shrink w--[{{ bn }}cqw]"></div>{%- endif -%}
        </div>
      </div>
      {%- else -%}
      <span class="label label--gray">{{ t_senate }} · {{ t_gov }} : –</span>
      {%- endfor -%}
    </div>
    <div class="col--span-6 flex flex--col flex--left flex--top gap--xsmall">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="title title--small">{{ t_delegation }}</span>
        <span class="label label--small">D {{ hs.d }} · R {{ hs.r }} · {{ hs.called }}/{{ hs.total }}</span>
      </div>
      {%- for dev in devs -%}
      {%- if dev == "og" -%}{%- assign nk = 13 -%}{%- assign vis = "lg:hidden" -%}{%- else -%}{%- assign nk = 26 -%}{%- assign vis = "hidden lg:grid" -%}{%- endif -%}
      {%- assign ncol = 1 -%}{%- if focus.house_races.size > nk -%}{%- assign ncol = 2 -%}{%- endif -%}
      <div class="grid grid--cols-{{ ncol }} gap--medium w--full {{ vis }}">
        {%- for colno in (1..ncol) -%}
        {%- assign skip = colno | minus: 1 | times: nk -%}
        <div class="flex flex--col flex--left flex--top gap--xsmall">
        {%- for r in focus.house_races offset: skip limit: nk -%}
          <div class="flex flex--row flex--between flex--center-y gap--small w--full">
            <span class="label label--small"><span class="text--bold">{{ r.lbl | split: "-" | last }}&nbsp;</span>{% if r.s == "wait" %}{{ r.a.n }} / {{ r.b.n }}{% else %}{{ r.wn }}{% endif %}</span>
            {%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.w }}{% if r.f == 1 %} {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.w }} +{{ r.mg | round }}</span>{%- else -%}<span class="label label--small label--gray">–</span>{%- endif -%}
          </div>
        {%- endfor -%}
        </div>
        {%- endfor -%}
      </div>
      {%- assign shown = nk | times: 2 -%}
      {%- if focus.house_races.size > shown -%}<span class="label label--small label--gray {{ vis }}">+ {{ focus.house_races.size | minus: shown }}</span>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

