{%- assign devs = "og,x" | split: "," -%}
<div class="layout layout--col layout--top layout--stretch-x gap--small">
{%- if view == "senate" or view == "house" or view == "governors" or view == "overview" -%}
  {%- case view -%}
    {%- when "senate" -%}{%- assign chs = "senate" | split: "," -%}{%- assign list = senate_races -%}
    {%- when "house" -%}{%- assign chs = "house" | split: "," -%}{%- assign list = house_key -%}
    {%- when "governors" -%}{%- assign chs = "gov" | split: "," -%}{%- assign list = gov_races -%}
    {%- else -%}{%- assign chs = "senate,house,gov" | split: "," -%}{%- assign list = calls -%}
  {%- endcase -%}
  {%- for ch in chs -%}
    {%- case ch -%}
      {%- when "senate" -%}{%- assign c = senate -%}{%- assign tot = 100 -%}{%- assign cname = t_senate -%}{%- assign need = "51" -%}
      {%- when "house" -%}{%- assign c = house -%}{%- assign tot = 435 -%}{%- assign cname = t_house -%}{%- assign need = "218" -%}
      {%- else -%}{%- assign c = gov -%}{%- assign tot = 50 -%}{%- assign cname = t_gov -%}{%- assign need = "" -%}
    {%- endcase -%}
    {%- comment -%} full-width bar: 1cqw = 3.8px on OG half views {%- endcomment -%}
    {%- assign w = c.d | times: 99.0 | divided_by: tot -%}{%- assign dn = w | floor -%}{%- assign dp = w | minus: dn | times: 3.8 | round -%}
    {%- assign w = c.r | times: 99.0 | divided_by: tot -%}{%- assign rn = w | floor -%}{%- assign rp = w | minus: rn | times: 3.8 | round -%}
    <div class="flex flex--col flex--left flex--top gap--xsmall w--full">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="title title--small">{{ cname }}</span>
        {%- if c.ctrl == "D" or c.ctrl == "R" -%}<span class="label label--small label--inverted">{% if c.ctrl == "D" %}{{ t_ctrl_d }}{% else %}{{ t_ctrl_r }}{% endif %}</span>{%- else -%}<span class="label label--small label--gray">{{ c.called }}/{{ c.total }} {{ t_called }}</span>{%- endif -%}
      </div>
      <div class="flex flex--row flex--between flex--bottom w--full">
        <div class="flex flex--row flex--bottom gap--small"><span class="value {% if chs.size > 1 %}value--small{% else %}value--large{% endif %} value--tnums">{{ c.d }}</span><span class="label label--small">{{ t_dem }}</span></div>
        <div class="flex flex--row flex--bottom gap--small"><span class="label label--small">{{ t_rep }}</span><span class="value {% if chs.size > 1 %}value--small{% else %}value--large{% endif %} value--tnums">{{ c.r }}</span></div>
      </div>
      <div class="flex flex--row gap--none w--full h--[12px] outline">
        {%- if dn > 0 -%}<div class="bg--black h--full no-shrink w--[{{ dn }}cqw]"></div>{%- endif -%}{%- if dp > 0 -%}<div class="bg--black h--full no-shrink w--[{{ dp }}px]"></div>{%- endif -%}
        <div class="grow h--full"></div>
        {%- if rp > 0 -%}<div class="bg--gray-50 h--full no-shrink w--[{{ rp }}px]"></div>{%- endif -%}{%- if rn > 0 -%}<div class="bg--gray-50 h--full no-shrink w--[{{ rn }}cqw]"></div>{%- endif -%}
      </div>
      <span class="label label--small label--gray" data-clamp="1">{% if need != "" %}{{ need }} {{ t_to_win }}{% else %}{{ c.won_d }}–{{ c.won_r }} / {{ c.total }}{% endif %} · {{ t_flips }} D+{{ c.flip_d }} R+{{ c.flip_r }}</span>
    </div>
  {%- endfor -%}
  <div class="divider"></div>
  {%- if view == "overview" -%}
    {%- assign rlist = calls -%}{%- assign ogn = 4 -%}{%- assign xn = 12 -%}
    <span class="title title--small">{{ t_latest }}</span>
  {%- else -%}
    {%- assign l1 = list | where: "s", "lead" -%}{%- assign l2 = list | where: "s", "wait" -%}{%- assign l3 = list | where: "s", "called" -%}
    {%- assign rlist = l1 | concat: l2 | concat: l3 -%}{%- assign ogn = 10 -%}{%- assign xn = 22 -%}
  {%- endif -%}
{%- elsif view == "battleground" or view == "calls" -%}
  {%- if view == "battleground" -%}
    {%- assign l1 = battle | where: "s", "lead" -%}{%- assign l2 = battle | where: "s", "wait" -%}{%- assign l3 = battle | where: "s", "called" -%}
    {%- assign rlist = l1 | concat: l2 | concat: l3 -%}
  {%- else -%}{%- assign rlist = calls -%}{%- endif -%}
  {%- assign ogn = 16 -%}{%- assign xn = 27 -%}
  <span class="title title--small">{% if view == "battleground" %}{{ t_battle }}{% else %}{{ t_latest }}{% endif %}</span>
{%- elsif view == "state" -%}
  {%- assign statewide = focus.senate | concat: focus.gov -%}
  {%- assign hs = focus.house -%}
  <span class="title title--small">{{ focus.nm }}</span>
  {%- for r in statewide -%}
  <div class="flex flex--col flex--left flex--top gap--xsmall w--full">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="label label--small text--bold">{% if r.o == "S" %}{{ t_senate }}{% if r.sp == 1 %}*{% endif %}{% else %}{{ t_gov1 }}{% endif %}</span>
      {%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.w }} {{ t_win }}{% if r.f == 1 %} · {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.in }}% {{ t_in }}</span>{%- else -%}<span class="label label--small label--gray">{% if lang == "fr" %}{{ r.rtfr }}{% else %}{{ r.rt }}{% endif %}</span>{%- endif -%}
    </div>
    <div class="flex flex--row flex--between w--full"><span class="label label--small">{{ r.a.n }} ({{ r.a.p }})</span><span class="value value--xxsmall value--tnums">{% if r.s != "wait" %}{{ r.a.pct }}%{% else %}–{% endif %}</span></div>
    <div class="flex flex--row flex--between w--full"><span class="label label--small">{{ r.b.n }} ({{ r.b.p }})</span><span class="value value--xxsmall value--tnums">{% if r.s != "wait" %}{{ r.b.pct }}%{% else %}–{% endif %}</span></div>
  </div>
  {%- endfor -%}
  <div class="divider"></div>
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="label label--small text--bold">{{ t_delegation }}</span>
    <span class="label label--small">D {{ hs.d }} · R {{ hs.r }} · {{ hs.called }}/{{ hs.total }}</span>
  </div>
  {%- assign rlist = focus.house_races -%}{%- assign ogn = 11 -%}{%- assign xn = 24 -%}
{%- endif -%}

{%- if rlist.size > 0 -%}
  {%- for dev in devs -%}
  {%- if dev == "og" -%}{%- assign nk = ogn -%}{%- assign vis = "lg:hidden" -%}{%- else -%}{%- assign nk = xn -%}{%- assign vis = "hidden lg:flex" -%}{%- endif -%}
  {%- if view == "state" and statewide.size > 1 -%}{%- assign nk = nk | minus: 3 -%}{%- endif -%}
  <div class="flex flex--col flex--left flex--top gap--xsmall w--full {{ vis }}">
  {%- for r in rlist limit: nk -%}
    <div class="flex flex--row flex--between flex--center-y gap--small w--full">
      <span class="label label--small"><span class="text--bold">{{ r.lbl }}{% if r.o == "S" and view != "senate" %} Sen{% elsif r.o == "G" and view != "governors" %} Gov{% endif %}&nbsp;</span>{% if r.s == "wait" %}{{ r.a.n }} / {{ r.b.n }}{% elsif r.s == "called" %}{{ r.wn }}{% else %}{{ r.a.pct }}–{{ r.b.pct }}{% endif %}</span>
      {%- if r.s == "called" -%}<span class="label label--small label--inverted">{{ r.w }}{% if r.f == 1 %} {{ t_flip }}{% endif %}</span>{%- elsif r.s == "lead" -%}<span class="label label--small label--outline">{{ r.w }} +{{ r.mg }}</span>{%- else -%}<span class="label label--small label--gray">{% if lang == "fr" %}{{ r.rtfr }}{% else %}{{ r.rt }}{% endif %}</span>{%- endif -%}
    </div>
  {%- endfor -%}
  </div>
  {%- endfor -%}
{%- elsif view != "state" -%}
  <span class="label label--small label--gray">{% if phase == "pre" %}{{ t_first }} {{ cd_h }}h{% if cd_m < 10 %}0{% endif %}{{ cd_m }}{% else %}{{ t_none }}{% endif %}</span>
{%- endif -%}
</div>
{{ title_bar_short }}
